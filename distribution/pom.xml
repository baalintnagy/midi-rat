<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.midirat</groupId>
    <artifactId>midi-rat-parent</artifactId>
    <version>0.2.0</version>
  </parent>
  <artifactId>midi-rat-distribution</artifactId>
  <packaging>pom</packaging>
  <properties><midirat.style.skip>true</midirat.style.skip></properties>
  <dependencies>
    <dependency>
      <groupId>io.midirat</groupId>
      <artifactId>midi-rat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.midirat</groupId>
      <artifactId>midi-rat-sostenuto</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>windows-package</id>
      <activation><os><family>Windows</family></os></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>app-image</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <workingDirectory>${project.basedir}/..</workingDirectory>
                  <executable>pwsh.exe</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-File</argument>
                    <argument>scripts/package.ps1</argument>
                    <argument>-Version</argument>
                    <argument>${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
